{
  "name": "@timebridge/prometheus",
  "version": "0.0.7",
  "description": "Prometheus adapter for TimeBridge - metrics data source connector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate-parser": "peggy --format commonjs -o src/generated/promql-parser.js grammar/promql.peggy",
    "prebuild": "npm run generate-parser",
    "build": "tsc && cp -r src/generated dist/generated 2>/dev/null || true",
    "clean": "rm -rf dist src/generated",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --testPathIgnorePatterns=/integration/",
    "test:integration": "jest --config jest.integration.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write 'src/**/*.{ts,tsx}'"
  },
  "keywords": [
    "timebridge",
    "prometheus",
    "promql",
    "metrics",
    "time-series",
    "correlation"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "@timebridge/core": "file:../../core",
    "node-fetch": "^2.7.0",
    "peggy": "^4.0.3",
    "socks-proxy-agent": "^8.0.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.7",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.2"
  }
}
