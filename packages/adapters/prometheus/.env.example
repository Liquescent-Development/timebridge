# Prometheus Adapter Integration Test Configuration
# Copy this file to .env and fill in your Prometheus instance details

# Prometheus server URL (required)
PROMETHEUS_URL=http://localhost:9090

# Authentication (optional)
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_API_TOKEN=

# Query settings
PROMETHEUS_STEP=15s
PROMETHEUS_POLL_INTERVAL=0
PROMETHEUS_TIMEOUT=30000
PROMETHEUS_MAX_RETRIES=3

# SOCKS proxy configuration (optional)
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=1080
SOCKS_PROXY_TYPE=5
SOCKS_PROXY_USERNAME=
SOCKS_PROXY_PASSWORD=

# Test configuration
PROMETHEUS_TEST_TIMEOUT=15000
PROMETHEUS_MAX_EVENTS=50
PROMETHEUS_TEST_VERBOSE=false

# Sample queries - customize for your Prometheus instance
PROMETHEUS_QUERY_BASIC=up
PROMETHEUS_QUERY_COUNTER=prometheus_notifications_total
PROMETHEUS_QUERY_GAUGE=prometheus_config_last_reload_successful
PROMETHEUS_QUERY_HISTOGRAM=prometheus_http_request_duration_seconds_bucket
PROMETHEUS_QUERY_RATE=rate(prometheus_notifications_total[5m])
PROMETHEUS_QUERY_AGG=sum(up)
PROMETHEUS_QUERY_BINARY=up * 100
PROMETHEUS_QUERY_LABELS=up{job="prometheus"}
PROMETHEUS_QUERY_MULTI=prometheus_notifications_total{instance=~".*",job="prometheus"}
PROMETHEUS_QUERY_RANGE=increase(prometheus_notifications_total[1h])
PROMETHEUS_QUERY_CORRELATION=up{job=~".*"}

# Field mappings
PROMETHEUS_FIELD_INSTANCE=instance
PROMETHEUS_FIELD_JOB=job
PROMETHEUS_FIELD_METRIC=__name__
PROMETHEUS_FIELD_REQUEST_ID=request_id
PROMETHEUS_FIELD_TRACE_ID=trace_id
PROMETHEUS_FIELD_SPAN_ID=span_id
PROMETHEUS_FIELD_CORRELATION_ID=correlation_id

# Correlation settings
PROMETHEUS_CORRELATION_FIELD=instance
PROMETHEUS_CORRELATION_FIELDS=instance,job,request_id,trace_id

# Expectations (minimum results for test validation)
PROMETHEUS_MIN_BASIC=0
PROMETHEUS_MIN_COUNTER=0
PROMETHEUS_MIN_GAUGE=0
PROMETHEUS_EXPECTED_LABELS=instance,job

# Debug settings
PROMETHEUS_DEBUG_RAW=false
PROMETHEUS_DEBUG_QUERIES=false
PROMETHEUS_SAVE_RESULTS=false
PROMETHEUS_RESULTS_PATH=./test-results