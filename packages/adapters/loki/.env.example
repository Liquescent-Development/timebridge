# Loki Adapter Integration Test Configuration
# Copy this file to .env and fill in your Loki instance details

# Loki server URL (required)
LOKI_URL=http://localhost:3100

# Authentication (optional)
LOKI_USERNAME=
LOKI_PASSWORD=

# Connection settings
LOKI_TIMEOUT=30000
LOKI_MAX_RETRIES=3

# Test configuration
LOKI_TEST_TIMEOUT=30000
LOKI_MAX_EVENTS=100
LOKI_TEST_VERBOSE=false

# Enable tests even if no URL is configured (for mock testing)
RUN_LOKI_TESTS=false

# Sample LogQL queries - customize for your Loki instance
LOKI_QUERY_BASIC={job=~".+"}
LOKI_QUERY_SERVICE={service="api"}
LOKI_QUERY_ERRORS={level="error"}
LOKI_QUERY_WARNINGS={level=~"warn|warning"}
LOKI_QUERY_MULTI={service="frontend",level="error"}
LOKI_QUERY_REGEX={job=~".*nginx.*"}
LOKI_QUERY_CORRELATION={trace_id=~".+"}

# Field mappings
LOKI_FIELD_JOB=job
LOKI_FIELD_INSTANCE=instance
LOKI_FIELD_SERVICE=service
LOKI_FIELD_LEVEL=level
LOKI_FIELD_REQUEST_ID=request_id
LOKI_FIELD_TRACE_ID=trace_id
LOKI_FIELD_SESSION_ID=session_id
LOKI_FIELD_CORRELATION_ID=correlation_id

# Correlation settings
LOKI_CORRELATION_FIELD=trace_id
LOKI_CORRELATION_FIELDS=trace_id,request_id,session_id,correlation_id

# Expectations (minimum results for test validation)
LOKI_MIN_BASIC=0
LOKI_MIN_SERVICE=0
LOKI_MIN_ERRORS=0
LOKI_EXPECTED_LABELS=job,instance

# Debug settings
LOKI_DEBUG_RAW=false
LOKI_DEBUG_QUERIES=false
LOKI_SAVE_RESULTS=false
LOKI_RESULTS_PATH=./test-results