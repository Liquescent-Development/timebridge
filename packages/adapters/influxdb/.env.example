# InfluxDB Adapter Integration Test Configuration
# Copy this file to .env and fill in your InfluxDB instance details

# InfluxDB server URL (required)
INFLUXDB_URL=http://localhost:8086

# InfluxDB version: "1.x" or "2.x" (default: "1.x")
INFLUXDB_VERSION=1.x

# Time precision for queries (ns|u|ms|s|m|h, default: "ms")
INFLUXDB_PRECISION=ms

# InfluxDB 1.x configuration
INFLUXDB_DATABASE=mydb
INFLUXDB_USERNAME=
INFLUXDB_PASSWORD=

# InfluxDB 2.x configuration
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# Connection settings
INFLUXDB_POLL_INTERVAL=0
INFLUXDB_TIMEOUT=30000
INFLUXDB_MAX_RETRIES=3

# SOCKS proxy configuration (optional)
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=1080
SOCKS_PROXY_TYPE=5
SOCKS_PROXY_USERNAME=
SOCKS_PROXY_PASSWORD=

# Test configuration
INFLUXDB_TEST_TIMEOUT=20000
INFLUXDB_MAX_EVENTS=100
INFLUXDB_TEST_VERBOSE=false

# Sample queries for InfluxDB 1.x (InfluxQL)
INFLUXDB_QUERY_BASIC=SELECT * FROM measurement LIMIT 10
INFLUXDB_QUERY_TIMESERIES=SELECT time, value FROM temperature ORDER BY time DESC LIMIT 50
INFLUXDB_QUERY_FIELDS=SELECT temperature, humidity FROM sensors LIMIT 20
INFLUXDB_QUERY_AGG=SELECT MEAN(value) FROM measurement WHERE time > now() - 1h GROUP BY time(10m)
INFLUXDB_QUERY_MATH=SELECT value * 2 FROM measurement WHERE time > now() - 30m LIMIT 10
INFLUXDB_QUERY_WHERE=SELECT * FROM measurement WHERE value > 10 AND time > now() - 1h
INFLUXDB_QUERY_GROUP=SELECT MEAN(value) FROM measurement WHERE time > now() - 2h GROUP BY host
INFLUXDB_QUERY_TAGS=SELECT * FROM measurement WHERE time > now() - 30m LIMIT 10
INFLUXDB_QUERY_CORRELATION=SELECT * FROM measurement WHERE (request_id != '' OR trace_id != '') AND time > now() - 1h LIMIT 20
INFLUXDB_QUERY_TAG_CORR=SELECT * FROM measurement WHERE time > now() - 30m GROUP BY host, service LIMIT 10

# InfluxDB 1.x specific queries
INFLUXDB_V1_FUNCTION=SELECT DERIVATIVE(mean(value)) FROM measurement WHERE time > now() - 1h GROUP BY time(10m)
INFLUXDB_V1_CQ=SELECT * FROM cq_result WHERE time > now() - 1h LIMIT 20

# Sample queries for InfluxDB 2.x (Flux) - uncomment and customize if using 2.x
# INFLUXDB_QUERY_BASIC=from(bucket: "test") |> range(start: -5m)
# INFLUXDB_QUERY_TIMESERIES=from(bucket: "test") |> range(start: -1h) |> sort(columns: ["_time"])
# INFLUXDB_QUERY_FIELDS=from(bucket: "test") |> range(start: -30m) |> filter(fn: (r) => r._field == "value")
# INFLUXDB_QUERY_AGG=from(bucket: "test") |> range(start: -1h) |> mean()
# INFLUXDB_QUERY_MATH=from(bucket: "test") |> range(start: -30m) |> map(fn: (r) => ({r with _value: r._value * 2}))
# INFLUXDB_QUERY_WHERE=from(bucket: "test") |> range(start: -1h) |> filter(fn: (r) => r._value > 10.0)
# INFLUXDB_QUERY_GROUP=from(bucket: "test") |> range(start: -2h) |> group(columns: ["host"]) |> mean()
# INFLUXDB_QUERY_TAGS=from(bucket: "test") |> range(start: -30m) |> keep(columns: ["_time", "_field", "_value", "host", "region"])
# INFLUXDB_QUERY_CORRELATION=from(bucket: "test") |> range(start: -1h) |> filter(fn: (r) => exists r.request_id or exists r.trace_id)
# INFLUXDB_QUERY_TAG_CORR=from(bucket: "test") |> range(start: -30m) |> group(columns: ["host", "service"])

# InfluxDB 2.x specific queries
# INFLUXDB_V2_TRANSFORM=from(bucket: "test") |> range(start: -30m) |> filter(fn: (r) => r._measurement == "temperature") |> map(fn: (r) => ({r with celsius: (r._value - 32.0) * 5.0 / 9.0}))
# INFLUXDB_V2_FILTER=from(bucket: "test") |> range(start: -1h) |> filter(fn: (r) => r._measurement == "cpu" and r.host == "server01")

# Field mappings
INFLUXDB_FIELD_MEASUREMENT=_measurement
INFLUXDB_FIELD_TIME=time
INFLUXDB_FIELD_VALUE=_value
INFLUXDB_FIELD_FIELD=_field
INFLUXDB_FIELD_HOST=host
INFLUXDB_FIELD_REGION=region
INFLUXDB_FIELD_SERVICE=service
INFLUXDB_FIELD_REQUEST_ID=request_id
INFLUXDB_FIELD_TRACE_ID=trace_id
INFLUXDB_FIELD_SPAN_ID=span_id
INFLUXDB_FIELD_CORRELATION_ID=correlation_id

# Correlation settings
INFLUXDB_CORRELATION_FIELD=host
INFLUXDB_CORRELATION_FIELDS=host,service,request_id,trace_id

# Expectations (minimum results for test validation)
INFLUXDB_MIN_BASIC=0
INFLUXDB_MIN_TIMESERIES=0
INFLUXDB_MIN_AGG=0
INFLUXDB_EXPECTED_FIELDS=_measurement,_time,_value

# Debug settings
INFLUXDB_DEBUG_RAW=false
INFLUXDB_DEBUG_QUERIES=false
INFLUXDB_SAVE_RESULTS=false
INFLUXDB_RESULTS_PATH=./test-results