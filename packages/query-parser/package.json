{
  "name": "@timebridge/timeql-parser",
  "version": "0.0.7",
  "description": "TimeQL query parser for TimeBridge - time-series correlation language",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate-parser": "peggy --format commonjs -o src/generated/parser.js grammar/timeql.peggy",
    "prebuild": "npm run generate-parser",
    "build": "tsc && cp -r src/generated dist/generated",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist src/generated",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=/integration/",
    "test:integration": "jest test/integration"
  },
  "keywords": [
    "timeql",
    "timebridge",
    "query",
    "parser",
    "time-series",
    "correlation"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "@timebridge/core": "file:../core",
    "peggy": "^3.0.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
